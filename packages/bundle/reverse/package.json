{
  "name": "@deepseek-ai/dsh-reverse-bundle",
  "description": "The reverse-engineering capability as an optional profile bundle: one bridge to the SpringBoard resident plus the process, Mach-O, symbol, memory and tweak tools it serves",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/reverse"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-reverse-bridge": "workspace:*",
    "@deepseek-ai/dsh-reverse-protocol": "workspace:*",
    "@deepseek-ai/dsh-reverse-scripts": "workspace:*",
    "@deepseek-ai/dsh-tool-reverse-macho": "workspace:*",
    "@deepseek-ai/dsh-tool-reverse-memory": "workspace:*",
    "@deepseek-ai/dsh-tool-reverse-process": "workspace:*",
    "@deepseek-ai/dsh-tool-reverse-symbol": "workspace:*",
    "@deepseek-ai/dsh-tool-reverse-theos": "workspace:*",
    "@deepseek-ai/dsh-tool-reverse-tweak": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
